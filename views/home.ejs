<%- include("partials/header.ejs") %>

<div class="container my-5">
  <div class="row justify-content-center">

    <div class="col-12 col-lg-8 col-xl-9">
      <div class="content p-4">

        <% if (posts.length === 0) { %>
          <div class="text-center py-5">
            <h2 class="fw-semibold">So empty here... 😟</h2>
            <p class="mt-3 fs-5 text-muted">
              Start by creating your first blog post.
            </p>
          </div>
        <% } else { %>

          <ul class="p-0 list-unstyled">
            <% posts.forEach((post, index) => { %>
              <li class="mb-5">
                <p class="fs-6 fw-light text-muted"><%= post.date %></p>

                <h3 class="fs-2 pt-serif">
                  <a href="/view/<%= index %>" class="text-decoration-none">
                    <%= post.title %>
                  </a>
                </h3>

                <p class="fs-5 my-4">
                  <%= post.content %>
                </p>

                <hr />
              </li>
            <% }); %>
          </ul>

        <% } %>
      </div>
    </div>

    <div class="col-lg-4 col-xl-3 d-none d-lg-block">
      <div class="content p-4">

        <div class="mb-4">
          <a href="/create" class="btn btn-light btn-lg w-100">
            Create Post
          </a>
        </div>

        <% if (posts.length === 0) { %>
          <p class="text-center text-muted">No posts yet...</p>
        <% } else { %>
          <p class="fw-semibold">RECENT POSTS</p>

          <ul class="list-unstyled">
            <% posts.forEach((post, index) => { %>
              <li class="mb-3">
                <a
                  href="/view/<%= index %>"
                  class="text-decoration-none fs-6 pt-serif"
                >
                  <%= post.title %>
                </a>
                <hr />
              </li>
            <% }); %>
          </ul>
        <% } %>

      </div>
    </div>

  </div>
</div>


<%- include("partials/footer") %>
